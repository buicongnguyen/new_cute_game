{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "isolatedModules": true, "noEmit": true, "strict": true,
    "skipLibCheck": true, "noUnusedLocals": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests"]
}
